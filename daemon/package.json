  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "path-to-regexp": "8.4.2",
    "proxy-addr": "2.0.8",
