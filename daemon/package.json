{
  "name": "littleimpd",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "bin": {
    "grimoire": "./src/cli.ts",
    "littleimp": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "dev": "bun --watch src/index.ts",
